generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Service {
  id                 String   @id @default(cuid())
  name               String   @unique
  specialtyCatalog   String?
  chiefName          String?
  // Agrupa varios servicios bajo un mismo jefe (ej. Pediatría y sus subespecialidades) — un
  // jefe_servicio asignado a un servicio con groupName ve TODOS los servicios que comparten
  // ese mismo groupName, no solo el suyo. null = servicio con jefe propio, sin agrupar.
  groupName          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  users              User[]
  agendas            Agenda[]
  shiftRotations     ShiftRotation[]
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String
  role          String
  passwordHash  String
  serviceId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  service       Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  sessions      AuthSession[]
  chiefAgendas  Agenda[]      @relation("AgendaChief")
  historyEvents AgendaHistory[] @relation("AgendaHistoryActor")
  audits        AgendaAudit[] @relation("AgendaAuditActor")
  notifications Notification[]
}

model Agenda {
  id              String             @id @default(cuid())
  externalId      String             @unique
  serviceId       String?
  chiefUserId     String?
  serviceSpecialty String?
  serviceName     String
  chiefName       String
  monthLabel      String
  // Periodo de programación (año) al que pertenece la agenda, ej. 2026, 2027. Permite tener la
  // agenda vigente y la del próximo periodo de un mismo servicio a la vez sin que se sumen en
  // tableros, cruce RRHH ni pabellón — todo se filtra por periodo.
  planningPeriod  Int                @default(2026)
  // externalId de la agenda de otro periodo de la que esta es copia provisional (ej. la 2027
  // copiada de la 2026 mientras llega la planilla nueva). Null = programación propia del periodo.
  copiedFrom      String?
  validFrom      DateTime?
  validTo         DateTime?
  status          String
  version         Int                @default(1)
  cnePct          Float              @default(0)
  appointments    Int                @default(0)
  pendingConfirm  Boolean            @default(false)
  lastUpdated     BigInt
  summaryAI       String?
  rejectionReason String?
  hoursJson       String             @default("{}")
  distributionJson String            @default("{}")
  sourceSnapshot  String?
  vigenciaAlerta15dEnviada Boolean   @default(false)
  vigenciaAlerta5dEnviada  Boolean   @default(false)
  vigenciaAlerta0dEnviada  Boolean   @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  service         Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  chiefUser       User?              @relation("AgendaChief", fields: [chiefUserId], references: [id], onDelete: SetNull)
  professionals   AgendaProfessional[]
  blocks          AgendaBlock[]
  historyEntries  AgendaHistory[]
  audits          AgendaAudit[]
  notifications   Notification[]

  @@index([serviceId, status])
  @@index([chiefUserId])
  @@index([planningPeriod])
}

model AgendaProfessional {
  id         String       @id @default(cuid())
  externalId String?
  agendaId   String
  name       String
  type       String
  professionCatalog String?
  trainingLevel String?
  isShiftOnly Boolean     @default(false)
  hasTurno   Boolean      @default(false)
  // RUT normalizado (solo dígitos, sin puntos/guión/DV) — permite cruzar contra el reporte de
  // RRHH (Dotación) por identificador único en vez de por nombre. Opcional: no todos los
  // profesionales ya cargados lo tienen todavía.
  rut        String?
  // Especialidad del catálogo propia del profesional. Null = usa la del servicio/agenda
  // (Agenda.serviceSpecialty). Existe para agendas que agrupan varias especialidades por
  // dispositivo, ej. CESAM con psiquiatría adulto e infanto-juvenil en una sola agenda.
  specialtyCatalog String?
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  agenda     Agenda       @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  blocks     AgendaBlock[]
  shiftRotationMemberships ShiftRotationMember[]
  shiftRotationOverrides      ShiftRotationOverride[] @relation("ShiftOverrideDay")
  shiftRotationOverridesNight ShiftRotationOverride[] @relation("ShiftOverrideNight")

  @@unique([agendaId, externalId])
  @@index([agendaId, type])
  @@index([rut])
}

model AgendaBlock {
  id              String             @id @default(cuid())
  externalId      String?
  agendaId        String
  professionalId  String
  catalogActivityId String?
  day             String
  startMinutes    Int
  durationMinutes Int
  process         String?
  activity        String?
  isClinical      Boolean            @default(true)
  hasPerformance  Boolean            @default(true)
  performance     Float              @default(0)
  suggestedPerformance Float?
  performanceSource String?
  box             String?
  observations    String?
  isShift         Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  agenda          Agenda             @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  professional    AgendaProfessional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  catalogActivity CatalogActivity?   @relation(fields: [catalogActivityId], references: [id], onDelete: SetNull)

  @@unique([agendaId, externalId])
  @@index([professionalId, day, startMinutes])
  @@index([catalogActivityId])
}

model AgendaHistory {
  id          String   @id @default(cuid())
  externalId  String?
  agendaId    String
  actorUserId String?
  dateLabel   String
  eventType   String?
  action      String
  fromStatus  String?
  toStatus    String?
  userName    String
  comment     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agenda      Agenda   @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  actorUser   User?    @relation("AgendaHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([agendaId, externalId])
  @@index([agendaId, createdAt])
}

model AgendaAudit {
  id          String   @id @default(cuid())
  agendaId     String
  actorUserId  String?
  entityType   String
  entityId     String?
  action       String
  userName     String?
  payloadJson  String?
  createdAt    DateTime @default(now())
  agenda       Agenda   @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  actorUser    User?    @relation("AgendaAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([agendaId, createdAt])
}

model AuthSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CatalogActivity {
  id                 String   @id @default(cuid())
  sourceId           String?
  process            String
  profession         String
  specialty          String
  activity           String
  isClinical         Boolean
  hasPerformance     Boolean
  rawProcess         String?
  rawType            String?
  rawPerformanceFlag String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  blocks             AgendaBlock[]

  @@unique([process, profession, specialty, activity])
  @@index([profession, specialty])
  @@index([process])
}

model ReferencePerformance {
  id                 String   @id @default(cuid())
  process            String
  activity           String
  specialty          String
  nationalValue      Float?
  localValue         Float?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([process, activity, specialty])
}

model Notification {
  id              String   @id @default(cuid())
  agendaId         String?
  destinationRole String?
  userId          String?
  text            String
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  agenda          Agenda?  @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([destinationRole, read])
  @@index([userId, read])
}

model NormativeDocument {
  id          String   @id @default(cuid())
  title       String
  summary     String
  documentDate DateTime?
  filePath    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Rotación de turno (Art. 15) calculada a partir de un orden fijo de personas + una fecha
// ancla, en vez de una tabla de fechas cargada mes a mes. Ver quién corresponde en una fecha
// dada se calcula con (fecha - anchorDate) mod cycleDays, salvo que exista un override puntual.
model ShiftRotation {
  id              String   @id @default(cuid())
  serviceId       String
  unidad          String
  puesto          String
  cycleDays       Int
  anchorDate      DateTime
  startMinutes    Int      @default(480)
  durationMinutes Int      @default(1440)
  active          Boolean  @default(true)
  // false para turnos que no deben restar horas de jornada al cruzarse (ej. un "llamado"
  // telefónico de respaldo) — igual aparecen en el calendario y en turnosUltimos30Dias, pero
  // se excluyen del cálculo de horas perdidas/efectivas.
  affectsJornada  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  service   Service                 @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  members   ShiftRotationMember[]
  overrides ShiftRotationOverride[]

  @@unique([serviceId, unidad, puesto])
  @@index([serviceId])
}

model ShiftRotationMember {
  id               String  @id @default(cuid())
  rotationId       String
  position         Int
  professionalId   String?
  professionalName String

  rotation     ShiftRotation       @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  professional AgendaProfessional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@unique([rotationId, position])
}

model ShiftRotationOverride {
  id               String   @id @default(cuid())
  rotationId       String
  date             DateTime
  professionalId   String?
  professionalName String
  note             String?
  // Cobertura dividida (ej. feriado legal cubierto por 2 personas en el mismo puesto): cuando
  // estos campos no son null, el turno completo de la rotación se reemplaza por DOS sub-turnos
  // ese día en vez de uno solo — el de arriba (professionalId/professionalName) pasa a ser el
  // tramo "día" 08:00-20:00, y estos campos son el tramo "noche" 20:00-08:00.
  splitProfessionalId   String?
  splitProfessionalName String?

  rotation          ShiftRotation       @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  professional      AgendaProfessional? @relation("ShiftOverrideDay", fields: [professionalId], references: [id], onDelete: SetNull)
  splitProfessional AgendaProfessional? @relation("ShiftOverrideNight", fields: [splitProfessionalId], references: [id], onDelete: SetNull)

  @@unique([rotationId, date])
}

// Snapshot del reporte de RRHH "Dotación" (una fila por línea de contrato — una persona puede
// tener varias). Cada carga nueva REEMPLAZA todo el contenido anterior; no se guarda histórico
// de cortes previos, solo el más reciente.
model HrContract {
  id                   String    @id @default(cuid())
  rut                  String
  dv                   String
  // N° de contrato del funcionario en el reporte de Dotación (un mismo RUT puede tener varios).
  correlativo          String?
  nombreFuncionario    String
  planta               String
  calidadJuridica      String
  ley                  String
  numeroHoras          Float?
  unidadDescripcion    String?
  cargo                String?
  funcionDescripcion   String?
  fechaInicioContrato  DateTime?
  fechaTerminoContrato DateTime?
  transitorio          Boolean   @default(false)
  createdAt            DateTime  @default(now())

  @@index([rut])
}

// Snapshot de la planificación semanal de pabellón (plantilla, no fechas reales — igual que la
// jornada). Una fila por celda de la grilla (pabellón + jornada + día): qué especialidad tiene
// asignado ese pabellón. Cada carga nueva reemplaza todo el contenido anterior. Una celda puede
// traer más de una especialidad separadas por "/" (uso compartido) — se guarda tal cual viene,
// el mapeo a servicios se resuelve al leer, no al importar (así una especialidad que se carga
// después empieza a cruzar sin tener que reimportar esta planilla).
model PabellonAllocation {
  id                String   @id @default(cuid())
  grupo             String   // "Pabellón Cirugía Mayor Ambulatoria" | "Pabellón Cirugía Mayor"
  pabellon          String   // "31", "1", etc.
  jornada           String   // "Mañana" | "Tarde"
  dia               String   // "Lunes".."Sábado"
  especialidadTexto String   // texto tal cual en la planilla, ej. "Cir. A. /Oftalmologia"
  createdAt         DateTime @default(now())

  @@index([dia, jornada])
}
